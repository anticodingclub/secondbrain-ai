# ─── Application ────────────────────────────────────────────────────────────
SECONDBRAIN_ENVIRONMENT=development
SECONDBRAIN_DEBUG=true
SECONDBRAIN_LOG_LEVEL=INFO
# "json" for production log aggregation, "console" for readable local output.
SECONDBRAIN_LOG_FORMAT=console

# ─── Database ───────────────────────────────────────────────────────────────
# Dev default (zero install). Production: postgresql+asyncpg://user:pass@host:5432/secondbrain
SECONDBRAIN_DATABASE_URL=sqlite+aiosqlite:///./data/secondbrain.db
SECONDBRAIN_DATABASE_ECHO=false
SECONDBRAIN_DATABASE_POOL_SIZE=10
SECONDBRAIN_DATABASE_MAX_OVERFLOW=20

# ─── Vector store (Qdrant) ──────────────────────────────────────────────────
# Leave QDRANT_URL empty to run Qdrant in embedded local mode at QDRANT_PATH.
SECONDBRAIN_QDRANT_URL=
SECONDBRAIN_QDRANT_API_KEY=
SECONDBRAIN_QDRANT_PATH=./data/qdrant
SECONDBRAIN_QDRANT_COLLECTION=secondbrain_chunks

# ─── Embeddings ─────────────────────────────────────────────────────────────
# fastembed | sentence_transformers | ollama
SECONDBRAIN_EMBEDDING_PROVIDER=fastembed
SECONDBRAIN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SECONDBRAIN_EMBEDDING_DIMENSIONS=384
SECONDBRAIN_EMBEDDING_BATCH_SIZE=32

# For the full-quality setup (requires: pip install -e ".[embeddings-torch]")
# SECONDBRAIN_EMBEDDING_PROVIDER=sentence_transformers
# SECONDBRAIN_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# SECONDBRAIN_EMBEDDING_DIMENSIONS=1024

# ─── Storage ────────────────────────────────────────────────────────────────
# local | s3
SECONDBRAIN_STORAGE_BACKEND=local
SECONDBRAIN_STORAGE_PATH=./data/storage
SECONDBRAIN_MAX_UPLOAD_BYTES=524288000

# ─── Security (Phase 2) ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECONDBRAIN_SECRET_KEY=change-me-in-production-this-value-is-not-secret
SECONDBRAIN_ACCESS_TOKEN_TTL_MINUTES=30
SECONDBRAIN_REFRESH_TOKEN_TTL_DAYS=14

# ─── LLM providers (Phase 7) ────────────────────────────────────────────────
# openai | gemini | anthropic | ollama
SECONDBRAIN_LLM_PROVIDER=ollama
SECONDBRAIN_LLM_MODEL=llama3.1
SECONDBRAIN_OLLAMA_BASE_URL=http://localhost:11434
SECONDBRAIN_OPENAI_API_KEY=
SECONDBRAIN_ANTHROPIC_API_KEY=
SECONDBRAIN_GEMINI_API_KEY=

# ─── CORS ───────────────────────────────────────────────────────────────────
SECONDBRAIN_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
